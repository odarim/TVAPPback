# FrankenPHP / Caddy configuration for the StreamPulse (TVAPP) Symfony backend.
#
# Render terminates TLS at its edge and forwards plain HTTP to the container on
# the port given by the $PORT environment variable (defaults to 10000 on Render,
# 8080 locally). We therefore bind to that port and disable Caddy's automatic
# HTTPS, since the platform handles certificates for us.

{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp
	order php_server before file_server

	# Render handles TLS; serve plain HTTP behind its proxy.
	auto_https off
}

:{$PORT:8080} {
	log {
		# Structured access logs to stdout so Render captures them.
		output stdout
		format json
	}

	# Compress responses.
	encode zstd br gzip

	# Symfony front controller lives in public/.
	root * /app/public

	# Honor X-Forwarded-* headers set by Render's proxy.
	# php_server routes every request through public/index.php.
	php_server
}
